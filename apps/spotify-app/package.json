{
  "name": "@spottoyt/spotify-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "NODE_ENV=production bun scripts/build.ts",
    "dev": "bun scripts/build.ts --watch",
    "link-spotify": "NODE_ENV=production bun scripts/build.ts --install && spicetify apply",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p scripts"
  },
  "dependencies": {
    "@spottoyt/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.12"
  }
}
