# Helper settings. All optional.
SPOTTOYT_PORT=4317
# Defaults to $XDG_DATA_HOME/spottoyt (~/.local/share/spottoyt)
SPOTTOYT_DATA_DIR=
# Defaults to $XDG_CONFIG_HOME/spottoyt (~/.config/spottoyt). Holds the YouTube cookie.
SPOTTOYT_CONFIG_DIR=
# Route the helper's YouTube traffic through a proxy, e.g. wireproxy for a VPN.
HTTPS_PROXY=
