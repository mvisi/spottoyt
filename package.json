{
  "name": "spottoyt",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@spottoyt/helper' --filter '@spottoyt/spotify-app' dev",
    "build": "bun run --filter '@spottoyt/spotify-app' build",
    "link-spotify": "bun run --filter '@spottoyt/spotify-app' link-spotify",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome lint .",
    "check": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/bun": "^1.3.3",
    "typescript": "^5.9.3"
  }
}
